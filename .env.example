# No secrets are needed to BUILD the site. Automatic contact delivery defaults OFF.
# Set these privately in Vercel, scoped to Preview during testing. Never use VITE_
# prefixes for credentials. Never commit a populated .env file or paste keys in chat.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
# Proposed sender only; do not activate until its domain is verified and approved.
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random value with at least 32 characters; keep it server-only.
CONTACT_RATE_LIMIT_SALT=
# Comma-separated exact HTTPS origins, no paths/wildcards. On Preview, the automatic
# VERCEL_URL origin is also accepted. No request Host header is used to grant access.
CONTACT_ALLOWED_ORIGINS=

# VERCEL_ENV and VERCEL_URL are automatic system variables; do not override them.
# Business-confirmed future canonical candidate: https://havenbluetech.com
# Keep unset until production origin readiness and launch are approved.
# SITE_URL=
